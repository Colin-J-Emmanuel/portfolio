---
import { site } from '../data/site';
interface Props { ruled?: boolean }
const { ruled = false } = Astro.props;
---
<div class="wrap">
  <nav class:list={['nav', 'container', { 'nav--ruled': ruled }]} aria-label="Main">
    <a href="/" class="nav__name">{site.name}</a>
    <div class="nav__links">
      <a href="/#projects">Projects</a>
      <a href ={site.links.writing || '#'}>Writing</a>
      <a href="/#about">About</a>
    </div>
  </nav>
</div>
